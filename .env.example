# Copy this file as .env (the real .env must never be committed to GitHub).
# Set values provided by your verified outgoing email provider.
SMARTRENT_SMTP_HOST=
SMARTRENT_SMTP_PORT=587
SMARTRENT_SMTP_FROM=
SMARTRENT_SMTP_USER=
SMARTRENT_SMTP_PASSWORD=
# For local use only; reset links from another device need a public HTTPS URL.
SMARTRENT_PUBLIC_URL=http://127.0.0.1:8000
